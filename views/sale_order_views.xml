<odoo>
    <record id="sale_order_project_registration" model="ir.ui.view">
        <field name="name">sale.order.acme.project.registration</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="x_tender_id" invisible="1"/>
                <field name="opportunity_id" invisible="1"/>
                <field name="acme_has_project" invisible="1"/>
                <field name="acme_registered_project_ids" invisible="1"/>
                <button name="action_acme_create_project" type="object" string="Create Project"
                        groups="acme_project_core.group_acme_edm"
                        invisible="state != 'sale' or (not x_tender_id and not opportunity_id) or acme_has_project"/>
                <button name="action_acme_create_project" type="object" string="Open Project"
                        groups="acme_project_core.group_acme_edm"
                        invisible="state != 'sale' or (not x_tender_id and not opportunity_id) or not acme_has_project"/>
            </xpath>
        </field>
    </record>
</odoo>
